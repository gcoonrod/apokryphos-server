# Bootstrap secrets for the apokryphos reference deployment.
#
# Copy to `.env` (which is gitignored) and replace every placeholder.
# `docker compose` reads this automatically.
#
# CRITICAL: rotate `KC_BOOTSTRAP_ADMIN_PASSWORD` immediately after first
# login by creating a new admin user in the master realm via the Keycloak
# admin UI, then deleting the bootstrap admin. The bootstrap admin
# password is stored as a plain env var here and remains valid until you
# remove the bootstrap user.

# ─── Keycloak master realm bootstrap admin ─────────────────────────────────
# These are used ONLY at first boot to create the initial admin user.
# After first login, create a proper admin user and delete this bootstrap.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-me-immediately-after-first-login

# ─── Postgres password (used by Keycloak only) ─────────────────────────────
# This database is internal to the compose network; the password does
# not need to be human-typed. Generate something high-entropy.
#   openssl rand -base64 32
KC_DB_PASSWORD=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_BASE64_32
